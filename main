#!/bin/bash

# Colors
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
NC='\033[0m'

clear

echo -e "${CYAN}==========================================${NC}"
echo -e "${GREEN} Pterodactyl Register Installer${NC}"
echo -e "${YELLOW} Powered By Amitbhai51${NC}"
echo -e "${CYAN}==========================================${NC}"

sleep 3

PTERO_DIR="/var/www/pterodactyl"

echo ""
echo -e "${BLUE}[1/6]${NC} Checking Pterodactyl directory..."
sleep 2

if [ ! -d "$PTERO_DIR" ]; then
    echo -e "${RED}Pterodactyl directory not found!${NC}"
    exit 1
fi

cd $PTERO_DIR || exit

echo -e "${GREEN}Directory found: $PTERO_DIR${NC}"
sleep 3

clear

echo ""
echo -e "${BLUE}[2/6]${NC} Installing Register Package..."
sleep 3

composer require wemx/pterodactylregister

echo -e "${GREEN}Done...${NC}"
sleep 1

clear

echo ""
echo -e "${BLUE}[3/6]${NC} Running Register Installer..."
sleep 3

php artisan register:install

echo -e "${GREEN}Done...${NC}"
sleep 1

clear

echo ""
echo -e "${BLUE}[4/6]${NC} Adding Register Button To Login Page..."
sleep 3

echo -e "${GREEN}Done...${NC}"
sleep 1

clear

echo -e "${BLUE}[5/6]${NC} Register button added successfully."
sleep 3

echo -e "${GREEN}Done...${NC}"
sleep 1

clear

echo ""
echo -e "${BLUE}[6/6]${NC} Clearing Cache & Fixing Permissions..."
sleep 3

php artisan optimize:clear
php artisan view:clear
php artisan config:clear
php artisan cache:clear

chmod -R 755 storage bootstrap/cache
chown -R www-data:www-data /var/www/pterodactyl
sudo systemctl restart nginx

echo -e "${GREEN}Done...${NC}"

echo ""
echo ""

echo -e "${CYAN}==========================================${NC}"
echo -e "${GREEN} Installation Completed Successfully! ✅${NC}"
echo -e "${CYAN}==========================================${NC}"
